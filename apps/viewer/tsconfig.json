{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mv/shared": [
        "../shared/index.ts"
      ],
      "@mv/shared/*": [
        "../shared/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "../shared"
  ],
  "exclude": [
    "node_modules",
    "../shared/**/*.test.ts"
  ]
}
