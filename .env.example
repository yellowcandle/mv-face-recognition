# Environment Variables for MV Face Recognition System
# Copy this file to .env and update the values as needed

# PyTorch Settings (for Apple Silicon/MPS)
PYTORCH_ENABLE_MPS_FALLBACK=1
INSIGHTFACE_ENABLE_MPS=1

# Application Settings
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=8080
GRADIO_SHARE=false
GRADIO_DEBUG=false

# Processing Settings
NO_ALBUMENTATIONS_UPDATE=1
INSIGHTFACE_DISABLE_LOGGING=1

# Python Settings
PYTHONPATH=/app

# Optional: Authentication (if you want to protect your app)
# GRADIO_AUTH=username:password

# Optional: Custom Directories
# CONTESTANTS_DIR=/app/source/photo/contestants
# VIDEOS_DIR=/app/source/videos
# CACHE_DIR=/app/cache
# OUTPUT_DIR=/app/output

# Optional: Face Recognition Settings
# USE_GPU=true
# SIMILARITY_THRESHOLD=0.42
# DETECTION_THRESHOLD=0.5
# FRAME_SKIP=30
# MAX_FACES_PER_FRAME=10

# Optional: Video Processing Settings
# DEFAULT_VIDEO_QUALITY=1080p
# ENABLE_YOUTUBE_DOWNLOAD=true
# VIDEO_DOWNLOAD_WORKERS=2

# Optional: ChromaDB Settings
# ENABLE_CHROMADB=true
# CHROMADB_PATH=/app/cache/chromadb

# Optional: Logging
# LOG_LEVEL=INFO
# LOG_FILE=/app/app.log

# Zeabur Specific (usually set automatically by platform)
# PORT=8080
# NODE_ENV=production