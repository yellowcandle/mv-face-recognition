# Dockerfile for MV Face Recognition Backend - Fly.io Deployment with CUDA
FROM ubuntu:22.04 as base

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV CUDA_VISIBLE_DEVICES=0
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Install Python and system dependencies
RUN apt-get update && apt-get install -y \
    # Python installation
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    python3-pip \
    # Video processing dependencies
    ffmpeg \
    # OpenCV dependencies
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgtk-3-0 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    # Additional ML dependencies
    libopenblas-dev \
    liblapack-dev \
    libhdf5-dev \
    # Networking and utilities
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# CUDA runtime will be provided by Fly.io's GPU machines
# PyTorch will detect and use GPU automatically via CUDA libraries

# Create symbolic links for python
RUN ln -s /usr/bin/python3.11 /usr/bin/python3 && \
    ln -s /usr/bin/python3.11 /usr/bin/python

WORKDIR /app

# Copy and install Python dependencies
COPY backend/requirements.txt ./backend/requirements.txt
COPY requirements.txt ./requirements.txt

# Install Python packages
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r backend/requirements.txt && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY src/ ./src/
COPY metadata/ ./metadata/
COPY config.json .
COPY fix_embeddings.py .

# Create necessary directories for data volumes
RUN mkdir -p /data/videos/source \
             /data/videos/processed \
             /data/embeddings/contestants \
             /data/metadata \
             /data/chroma_db \
             /data/output \
             /data/clips

# Set proper permissions
RUN chmod -R 755 /data

# Copy critical metadata to ensure it's available (respecting CLAUDE.md constraints)
RUN cp metadata/contestant_info.csv /data/metadata/ 2>/dev/null || echo "contestant_info.csv will be mounted from volume"

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"] 