{
  "$schema": "https://zeabur.com/schema.json",
  "name": "mv-face-recognition",
  "services": {
    "backend": {
      "buildCommand": "cd backend && pip install -r requirements.txt",
      "startCommand": "cd backend && uvicorn main:app --host 0.0.0.0 --port $PORT",
      "environment": "python",
      "envVars": {
        "PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION": "python",
        "PYTHONUNBUFFERED": "1"
      },
      "domains": [
        {
          "domain": "mv-face-recognition-api.zeabur.app"
        }
      ],
      "ports": [
        {
          "port": 8000,
          "type": "HTTP"
        }
      ],
      "regions": ["hkg", "sfo"],
      "plan": "pro",
      "rootDirectory": "./backend"
    },
    "frontend": {
      "buildCommand": "cd frontend && npm install && npm run build",
      "startCommand": "cd frontend && npm run preview -- --host 0.0.0.0 --port $PORT",
      "environment": "nodejs",
      "envVars": {
        "NODE_ENV": "production"
      },
      "domains": [
        {
          "domain": "mv-face-recognition.zeabur.app"
        }
      ],
      "ports": [
        {
          "port": 3000,
          "type": "HTTP"
        }
      ],
      "regions": ["hkg", "sfo"],
      "plan": "hobby",
      "rootDirectory": "./frontend"
    }
  },
  "volumes": {
    "video-storage": {
      "size": "10GB",
      "mountPath": "/app/source/videos"
    },
    "contestant-photos": {
      "size": "1GB", 
      "mountPath": "/app/source/photo/contestants"
    },
    "chroma-db": {
      "size": "2GB",
      "mountPath": "/app/data"
    }
  }
}